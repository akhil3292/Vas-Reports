<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>DataSource1</DataSourceReference>
      <CommandText>select * from clients where cancelled=0</CommandText>
    </Query>
    <Fields>
      <Field Name="id">
        <DataField>id</DataField>
        <rd:TypeName>System.Int32</rd:TypeName>
      </Field>
      <Field Name="ClientName">
        <DataField>ClientName</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Regno">
        <DataField>Regno</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="District">
        <DataField>District</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Typs">
        <DataField>Typs</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="DeploymentType">
        <DataField>DeploymentType</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="VAS_Enabled">
        <DataField>VAS_Enabled</DataField>
        <rd:TypeName>System.Boolean</rd:TypeName>
      </Field>
      <Field Name="Cancelled">
        <DataField>Cancelled</DataField>
        <rd:TypeName>System.Boolean</rd:TypeName>
      </Field>
      <Field Name="States">
        <DataField>States</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>